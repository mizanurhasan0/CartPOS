# Copy to .env and fill in real values. Never commit .env.
# Run with:  node --env-file=.env dist/index.js

# Required: secret used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Optional overrides (defaults live in settings.json)
# MONGODB_URL=mongodb://127.0.0.1:27017/POS
# PORT=4000
# CORS_ORIGIN=http://localhost:5173

# Mail (leave empty if you do not use password reset e-mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_NAME=CartPOS
EMAIL_FROM=from@example.com
